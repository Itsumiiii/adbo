# Git
.git
.gitignore
.gitattributes

# Local env files — never bake secrets into the image
.env
.env.example
.env.backup
.env.testing

# Node / front-end toolchain
node_modules
package.json
package-lock.json
yarn.lock
vite.config.*
.babelrc

# Dev / test files
tests
phpunit.xml
phpunit.xml.dist
.phpunit.result.cache

# Documentation & editor config
README.md
*.md
.editorconfig
.DS_Store

# Build artefacts that are regenerated at runtime by the entrypoint
storage/logs/*.log
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# vendor is re-built inside the builder stage — never copy host vendor/ into image
vendor
